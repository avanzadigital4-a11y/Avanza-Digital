# ── Headers de seguridad — todas las páginas ─────────────────────────────────
# Migrado del .htaccess (Apache) al equivalente de Netlify.
# El .htaccess anterior no hacía nada aquí — estos headers ahora sí funcionan.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(self)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://*.googletagmanager.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://js.sentry-cdn.com https://browser.sentry-cdn.com https://js.hs-scripts.com https://js.hs-banner.com https://js.hscollectedforms.net https://js.hs-analytics.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' data: https: blob:; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://www.google.com https://*.googletagmanager.com https://*.workers.dev https://avanza-digital.onrender.com https://avanzadigital.digital https://dolarapi.com https://api.mercadopago.com https://api-m.paypal.com https://*.ingest.sentry.io https://forms.hscollectedforms.net; frame-src 'self' https://www.googletagmanager.com https://www.mercadopago.com.ar https://www.paypal.com; object-src 'none'; base-uri 'self'; form-action 'self' https://www.mercadopago.com.ar https://www.paypal.com; frame-ancestors 'self';

# ── Caché — imágenes (1 año) ──────────────────────────────────────────────────
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.gif
  Cache-Control: public, max-age=31536000, immutable
/*.ico
  Cache-Control: public, max-age=31536000, immutable

# ── Caché — fuentes (1 año, inmutable) ───────────────────────────────────────
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# ── Caché — módulos JS del portal (nombre fijo, siempre valida) ──────────────
# Estos archivos (portal.core.js, portal.jarvis.js, etc.) conservan SIEMPRE el
# mismo nombre. Por eso NO pueden ser 'immutable': si lo fueran, el navegador
# serviría la copia vieja hasta un año tras editarlos en el lugar (había que
# hacer Ctrl+Shift+R). Con no-cache el navegador GUARDA el archivo pero pregunta
# al servidor si cambió antes de usarlo (If-None-Match). Si no cambió → 304
# instantáneo, no re-descarga. Si cambió → baja el nuevo. Deploy = cambio visible
# al instante, sin tocar el nombre y sin F5.
/assets/js/*
  Cache-Control: no-cache
/avanza-portal/assets/js/*
  Cache-Control: no-cache

# ── Caché — CSS y JS (sin caché fijo — siempre valida contra el servidor) ────
# ANTES tenían max-age=2592000 (30 días): el navegador servía el archivo viejo
# hasta un mes sin preguntar, obligando a hacer Ctrl+Shift+R tras cada deploy.
# Con no-cache el navegador GUARDA el archivo pero valida si cambió antes de
# usarlo (manda If-None-Match / If-Modified-Since). Si no cambió → 304 rápido.
# Si cambió → descarga el nuevo. Deploy nuevo = todos ven el cambio al instante.
/*.css
  Cache-Control: no-cache
/*.js
  Cache-Control: no-cache

# ── PWA del portal: el SW y el manifest NO se cachean ────────────────────────
# Si el navegador cachea sw.js un mes, los deploys del portal tardan un mes en
# llegar a los celulares instalados. Esta regla va DESPUÉS de /*.js y la pisa.
/avanza-portal/sw.js
  Cache-Control: no-cache
/avanza-portal/manifest.webmanifest
  Cache-Control: no-cache

# ── Caché — HTML (sin caché fijo — siempre valida contra el servidor) ────────
# Con max-age=3600 los usuarios podían ver HTML viejo hasta 1 hora.
# Con no-cache siempre valida: el HTML es liviano y es el punto de entrada;
# si el HTML es fresco, el usuario siempre parte de la versión correcta.
/*.html
  Cache-Control: no-cache